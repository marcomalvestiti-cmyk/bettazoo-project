PORT=3001
MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/bettazoo?retryWrites=true&w=majority
RPC_URL=ws://localhost:8545
CONTRACT_ADDRESS=0xYourDeployedContractAddress
ORACLE_PRIVATE_KEY=0xYourOraclePrivateKey
TREASURY_ADDRESS=0xYourTreasuryAddress
OPENAI_API_KEY=sk-...

# Event catalog (Tier 0) — leave ODDS_API_KEY unset to serve the curated fallback
# catalog only (data/curatedEvents.js); set it to sync real football fixtures from
# The Odds API (the-odds-api.com — free tier: 500 requests/month) via
# services/eventsFeedService.js. Default interval (12h) keeps 3 leagues comfortably
# inside that free-tier budget — see LIVE_SOCCER_LEAGUES in that file before lowering it.
ODDS_API_KEY=
EVENTS_SYNC_INTERVAL_MS=43200000

# Placer Vault (keeper + vault event indexing) — leave unset to disable both
VAULT_FACTORY_ADDRESS=0xYourPlacerVaultFactoryAddress
VAULT_FACTORY_DEPLOY_BLOCK=0
KEEPER_PRIVATE_KEY=0xYourKeeperWalletPrivateKey
KEEPER_TICK_MS=45000
