PORT=3001
MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/bettazoo?retryWrites=true&w=majority
RPC_URL=ws://localhost:8545
CONTRACT_ADDRESS=0xYourDeployedContractAddress
ORACLE_PRIVATE_KEY=0xYourOraclePrivateKey
TREASURY_ADDRESS=0xYourTreasuryAddress
OPENAI_API_KEY=sk-...

# Event catalog (Tier 0) — leave ODDS_API_KEY unset to serve the curated fallback
# catalog only (data/curatedEvents.js); set it to sync real football fixtures from
# The Odds API (the-odds-api.com — free tier: 500 requests/month) via
# services/eventsFeedService.js. Default interval (12h) keeps 3 leagues comfortably
# inside that free-tier budget — see LIVE_SOCCER_LEAGUES in that file before lowering it.
ODDS_API_KEY=
EVENTS_SYNC_INTERVAL_MS=43200000

# Automatic settlement of live fixtures (services/resultsService.js) — on whenever
# ODDS_API_KEY, RPC_URL, CONTRACT_ADDRESS and ORACLE_PRIVATE_KEY are all set. Reads
# final scores from The Odds API (2 credits per league check, only when a match is
# waiting for its result) and calls Escrow.resolveEvent with the oracle key.
# AUTO_RESOLVE_EVENTS=false turns it off; results are checked every 3h by default,
# starting 2.5h after kickoff (RESULT_GRACE_MS).
AUTO_RESOLVE_EVENTS=
RESULTS_SYNC_INTERVAL_MS=10800000

# Kickoff cutoff — the keeper cancels its offers this long before kickoff (default 5 min).
KEEPER_KICKOFF_CUTOFF_MS=300000

# Protocol vault auto-scope — when true, the Final Boss vault (PROTOCOL_TREASURY_ADDRESS)
# quotes every upcoming live fixture on all outcomes instead of its saved scope.
PROTOCOL_VAULT_AUTO_SCOPE=

# Final Boss vault (Tier 2) — the protocol's own treasury-capitalized vault. Set this
# to the treasury wallet's address once it has created a vault (factory.createVault())
# so the agreement/KYC gate (routes/vaults.js, services/keeperService.js) exempts it —
# see the comments at each usage for why. Leave unset until you actually have a
# treasury wallet address to put here; no code depends on this being set.
PROTOCOL_TREASURY_ADDRESS=

# Minimal shared-secret gate for /api/admin/* and POST /api/oracle/resolve (see
# middleware/adminAuth.js). Leave unset to keep those routes open (current/default
# behavior); set a real passphrase before sharing an admin page link with anyone
# beyond trusted testers — the frontend prompts for it once and stores it locally.
ADMIN_SECRET=

# Error tracking (Sentry) — leave unset to keep logging to console/Railway logs only
# (current/default behavior). Free tier at sentry.io is enough for a beta's volume.
SENTRY_DSN=

# Placer Vault (keeper + vault event indexing) — leave unset to disable both
VAULT_FACTORY_ADDRESS=0xYourPlacerVaultFactoryAddress
VAULT_FACTORY_DEPLOY_BLOCK=0
KEEPER_PRIVATE_KEY=0xYourKeeperWalletPrivateKey
KEEPER_TICK_MS=45000

# Fund Vault (Tier 3, item 2/3) — ERC-4626 vault for third-party LP capital
# (contracts/PlacerFundVault.sol + PlacerFundVaultFactory.sol), separate from the
# single-owner PlacerVault above. Points at the SAME already-deployed Escrow/USDT — no
# Escrow redeploy needed for this one, run web3/scripts/deploy-fundvault.js and paste
# its factory address/deploy block here. Reuses the same KEEPER_PRIVATE_KEY/
# KEEPER_TICK_MS above (one keeper process manages both vault types).
FUND_VAULT_FACTORY_ADDRESS=0xYourPlacerFundVaultFactoryAddress
FUND_VAULT_FACTORY_DEPLOY_BLOCK=0

# Vigorish per-vault (Tier 3): BettazooEscrow.sol is not upgradeable, so adding
# per-placer fee overrides required redeploying it (see web3/scripts/deploy-vig.js) —
# which also required a new PlacerVault implementation + PlacerVaultFactory (escrow
# address is `immutable` inside each vault clone). After running that script,
# CONTRACT_ADDRESS/ESCROW_DEPLOY_BLOCK/VAULT_FACTORY_ADDRESS/VAULT_FACTORY_DEPLOY_BLOCK/
# KEEPER_PRIVATE_KEY above all change to the new deployment's values — the old vault
# stays live at its old addresses (grandfathered, not migrated) but stops being indexed
# by this backend once you cut over.
